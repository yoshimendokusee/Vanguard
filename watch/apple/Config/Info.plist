<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vanguard settings merged into the generated Info.plist of VanguardPhone and
  VanguardWatch (INFOPLIST_FILE, with GENERATE_INFOPLIST_FILE = YES). Permission
  prompts stay as INFOPLIST_KEY_* build settings in Vanguard.xcodeproj. The nested
  local-network ATS dictionary is defined here because Xcode does not generate it
  from an INFOPLIST_KEY_NSAppTransportSecurity_NSAllowsLocalNetworking setting.
  Values come from Vanguard.xcconfig and the git-ignored
  Secrets.xcconfig. Everything here is readable from the installed app: public
  settings only, never passwords or secret/service-role keys.
-->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Read by AppConfiguration.load(); see Sources/VanguardApple/AppConfiguration.swift. -->
	<key>HUB_URL</key>
	<string>$(HUB_URL)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
</dict>
</plist>
