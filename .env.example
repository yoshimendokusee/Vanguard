# Copy to .env at the repository root. No secrets are needed by the current MVP.
# Root Docker Compose reads .env; native Node must load it explicitly (README).
HOSPITAL_NAME="Receiving Hospital · Emergency Department"
# Docker host port/address only. Use the laptop's LAN IP for a synthetic LAN demo.
# Omitting HUB_BIND_ADDRESS retains the existing Compose all-interface binding.
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=3000
# Native hub settings when run from hub/. Docker keeps port 3000 and /data/vanguard.db.
PORT=3000
# Native Node bind address for hub/server.js (process.env.HOST, defaults to 0.0.0.0).
# Use 127.0.0.1 to keep the hub on this computer only; 0.0.0.0 allows LAN devices.
HOST=0.0.0.0
DB_PATH=./data/vanguard.db
# Watch build-time settings. Flutter does not load this .env file automatically.
# Copy watch/env.json.example to watch/env.json (git-ignored) and build with
# --dart-define-from-file=env.json. Never use a Supabase secret key.
HUB_URL=http://192.168.8.10:3000
VOSK_MODEL=assets/models/vosk-model-small-en-us-0.15.zip
# Local AI (Qwen via Ollama) — hub computer only, never exposed to the internet.
# Ollama runs on the hospital computer; the hub calls it at OLLAMA_URL.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# One bounded Ollama call per request, no retries. Status check is shorter.
AI_TIMEOUT_MS=30000
AI_STATUS_TIMEOUT_MS=4000
# Transcript limit enforced by the hub before any inference call.
AI_MAX_TRANSCRIPT=4000
# Supabase cloud backup, read by the hub (Docker or native Node) from this
# git-ignored file. Flutter does not read it (see watch/env.json.example).
# Use the project's publishable key, never an sb_secret_* or service-role key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# The hub signs in as its own Supabase Auth user so RLS still applies. Create it in
# Supabase Dashboard > Authentication > Users. Server-side only; never in a client
# build. Leave any Supabase value empty to keep the hub LAN-only.
SUPABASE_HUB_EMAIL=<hub-account-email>
SUPABASE_HUB_PASSWORD=<hub-account-password>
# Online retry interval; failures back off up to 10 minutes. Minimum 5000.
CLOUD_SYNC_INTERVAL_MS=30000
# No BLE or on-device LLM variables: those integrations do not exist yet.
